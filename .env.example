# --- Server ---
PORT=3000
NODE_ENV=development
APP_RUNTIME_MODE=development

# --- Meta WhatsApp Cloud API ---
META_VERIFY_TOKEN=your_webhook_verify_token_here
META_ACCESS_TOKEN=your_meta_system_user_access_token_here
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
META_API_VERSION=v21.0
META_APP_SECRET=your_meta_app_secret_here

# Coach WhatsApp Numbers allowed for commands (comma-separated, country code, no +)
ADMIN_PHONE_NUMBERS=919876543210

# --- Database (Supabase PostgreSQL) ---
# If empty, runs in local in-memory storage mode
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# --- Redis (Optional for background BullMQ jobs) ---
REDIS_URL=

# --- Google Gemini AI API Key ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- App URL ---
APP_BASE_URL=http://localhost:3000
VITE_API_URL=

# Authenticated daily cleanup of anonymous and incomplete meeting visits
CRON_SECRET=
