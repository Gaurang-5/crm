{
  "version": 2,
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist/web",
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/src/db/migrations/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/health/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/crm/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/join",
      "destination": "/app.html"
    },
    {
      "source": "/login",
      "destination": "/app.html"
    },
    {
      "source": "/report",
      "destination": "/app.html"
    },
    {
      "source": "/body-analysis",
      "destination": "/app.html"
    }
  ],
  "crons": [
    {
      "path": "/api/maintenance/meeting-visits",
      "schedule": "0 3 * * *"
    }
  ]
}
