{
  "name": "herbalife-whatsapp-crm",
  "version": "1.0.0",
  "description": "Automated WhatsApp lead + follow-up CRM for a Herbalife coach",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p server/tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "test": "npm run test:api && npm run test:web",
    "test:api": "vitest run server/tests --config server/vitest.config.ts",
    "test:web": "vitest run web/tests --config web/vitest.config.ts",
    "test:db": "tsx scripts/test-db.ts",
    "test:ai": "tsx scripts/test-gemini.ts",
    "test:whatsapp": "tsx scripts/test-whatsapp.ts",
    "test:e2e": "playwright test",
    "start:web": "node dist/server.js",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@tanstack/react-query": "^5.101.4",
    "@types/cors": "^2.8.19",
    "@types/pdfkit": "^0.17.6",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.7.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.4.5",
    "vite": "^5.4.21",
    "vitest": "^4.1.11"
  },
  "workspaces": [
    "server",
    "web"
  ]
}